{
    "name": "horde/service_twitter",
    "description": "Twitter client library",
    "type": "library",
    "homepage": "https://www.horde.org/libraries/Horde_Service_Twitter",
    "license": "BSD-2-Clause",
    "authors": [
        {
            "name": "Michael J Rubinsky",
            "email": "mrubinsk@horde.org",
            "role": "lead"
        }
    ],
    "keywords": [
        "x.com",
        "twitter",
        "posts"
    ],
    "time": "2026-06-30",
    "repositories": [],
    "require": {
        "php": "^8.1",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^2.0",
        "horde/oauth": "^4 || dev-FRAMEWORK_6_0",
        "horde/controller": "^3 || dev-FRAMEWORK_6_0",
        "horde/exception": "^3 || dev-FRAMEWORK_6_0",
        "horde/http": "^3 || dev-FRAMEWORK_6_0",
        "horde/url": "^3 || dev-FRAMEWORK_6_0",
        "horde/util": "^3 || dev-FRAMEWORK_6_0"
    },
    "require-dev": {},
    "suggest": {},
    "autoload": {
        "psr-0": {
            "Horde_Service_Twitter": "lib/"
        },
        "psr-4": {
            "Horde\\Service\\Twitter\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Horde\\Service\\Twitter\\Test\\": "test/"
        }
    },
    "config": {
        "allow-plugins": {}
    },
    "extra": {
        "branch-alias": {
            "dev-FRAMEWORK_6_0": "3.x-dev"
        }
    }
}