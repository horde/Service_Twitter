{
    "minimum-stability": "dev",
    "name": "horde/service_twitter",
    "description": "Twitter client library",
    "type": "library",
    "homepage": "https://www.horde.org/libraries/Horde_Service_Twitter",
    "license": "BSD-2-Clause",
    "authors": [
        {
            "name": "Michael J Rubinsky",
            "email": "mrubinsk@horde.org",
            "role": "lead"
        }
    ],
    "time": "2021-07-04",
    "repositories": [
        {
            "type": "path",
            "url": "../Oauth",
            "options": {"symlink": true}
        },
        {
            "type": "path",
            "url": "../Controller",
            "options": {"symlink": true}
        },
        {
            "type": "path",
            "url": "../Exception",
            "options": {"symlink": true}
        },
        {
            "type": "path",
            "url": "../Http",
            "options": {"symlink": true}
        },
        {
            "type": "path",
            "url": "../Url",
            "options": {"symlink": true}
        },
        {
            "type": "path",
            "url": "../Util",
            "options": {"symlink": true}
        }
    ],
    "require": {
        "php": "^8.1",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^2.0",
        "horde/oauth": "* || dev-FRAMEWORK_6_0",
        "horde/controller": "* || dev-FRAMEWORK_6_0",
        "horde/exception": "* || dev-FRAMEWORK_6_0",
        "horde/http": "* || dev-FRAMEWORK_6_0",
        "horde/url": "* || dev-FRAMEWORK_6_0",
        "horde/util": "* || dev-FRAMEWORK_6_0"
    },
    "require-dev": {},
    "suggest": {},
    "autoload": {
        "psr-0": {
            "Horde_Service_Twitter": "lib/"
        },
        "psr-4": {
            "Horde\\Service\\Twitter\\V1\\": "src/V1/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Horde\\Service\\Twitter\\V1\\Test\\": "test/"
        }
    }
}